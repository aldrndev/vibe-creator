# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vibe_creator

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT AUTHENTICATION (REQUIRED - NO DEFAULTS IN PRODUCTION)
# =============================================================================
# Generate secure random strings (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=generate-a-secure-32-character-secret-here
JWT_REFRESH_SECRET=generate-another-secure-32-character-secret

# JWT Configuration
JWT_ISSUER=vibe-creator-api
JWT_AUDIENCE=vibe-creator-web
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# JWT Key Ring (for production key rotation)
# Generate with: node -e "const jose = require('jose'); jose.generateKeyPair('ES256').then(k => console.log(JSON.stringify(k)))"
JWT_SIGNING_KEY_ID=key-2026-01
JWT_SIGNING_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
JWT_VERIFY_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"..."}]

# =============================================================================
# CLOUDFLARE R2 (OBJECT STORAGE)
# =============================================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=vibe-creator
R2_PUBLIC_URL=https://your-bucket.r2.dev

# =============================================================================
# PAYMENT (XENDIT)
# =============================================================================
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-token

# =============================================================================
# CLOUDFLARE TURNSTILE (CAPTCHA)
# =============================================================================
# Development: use test key
# Production: create at https://dash.cloudflare.com/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# VIDEO PROCESSING
# =============================================================================
MAX_VIDEO_DURATION_MS=3600000
MAX_UPLOAD_SIZE_MB=2048
TEMP_DIR=./temp
OUTPUT_DIR=./output
MEDIA_INPUT_DIR=./uploads

# =============================================================================
# VIDEO DOWNLOAD (COBALT API)
# =============================================================================
# Optional: Self-hosted Cobalt API URL
# If not set, uses yt-dlp fallback
COBALT_API_URL=http://localhost:9000

# =============================================================================
# AI SERVICES (OPTIONAL)
# =============================================================================
# SaveSora API for downloading Sora videos
SAVESORA_API_KEY=your-savesora-api-key

# OpenAI for AI features
OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# TESTING
# =============================================================================
# Disable rate limiting for E2E tests
DISABLE_RATE_LIMIT=false
