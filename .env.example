# Root Environment Variables (Non-Secret)
# Use app-scoped env files for secrets:
# - apps/server/.env
# - apps/web/.env

# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Optional: Self-hosted Cobalt API URL
COBALT_API_URL=http://localhost:9000

# Production image tag (git SHA)
SERVER_IMAGE_TAG=
