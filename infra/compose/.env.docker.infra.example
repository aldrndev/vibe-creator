# Docker Infrastructure Environment Variables
# Copy to .env.docker.infra and fill with actual values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=vibe_creator

# Transcribe Infrastructure
TRANSCRIBE_LANGUAGE=mixed
WHISPER_MODEL_SIZE=medium
TRANSCRIBE_INSTALL_DIARIZATION=false
TRANSCRIBE_DIARIZATION_ENABLED=false
TRANSCRIBE_VAD_THRESHOLD=0.5
TRANSCRIBE_VAD_SPEECH_PAD_MS=300
TRANSCRIBE_VAD_MIN_SILENCE_MS=200
TRANSCRIBE_VAD_MIN_SPEECH_MS=80
