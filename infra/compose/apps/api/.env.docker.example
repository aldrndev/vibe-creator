# Docker API Environment Variables
# Copy to .env.docker and fill with actual values

# Database (Docker internal network - password matches .env.docker.infra)
DATABASE_URL=postgresql://postgres:your-password-here@postgres:5432/vibe_creator?schema=public

# Redis (Docker internal network)
REDIS_URL=redis://redis:6379

# JWT Secrets (use cryptographically secure random values)
JWT_SECRET=your-64-char-random-secret-here
JWT_REFRESH_SECRET=your-64-char-random-refresh-secret-here

# JWT Key Ring (ES256 - generate at jwt.io or use openssl)
JWT_SIGNING_KEY_ID=key-prod-2026
JWT_SIGNING_KEY={"kty":"EC","x":"...","y":"...","crv":"P-256","d":"..."}
JWT_VERIFY_KEYS=[{"kty":"EC","x":"...","y":"...","crv":"P-256"}]

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Auth
ENABLE_LEGACY_SESSION_AUTH=false
RATE_LIMIT_TEST_MODE=false

# Swagger (disable in production or protect)
ENABLE_SWAGGER=false
SWAGGER_ALLOWED_IPS=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vibe-creator
R2_PUBLIC_URL=

# Xendit Payment (optional)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Video Processing
MAX_VIDEO_DURATION_MS=3600000
MAX_UPLOAD_SIZE_MB=2048

# AI Services (optional)
SAVESORA_API_KEY=
AI_COPY_PROVIDER=ollama
OPENAI_API_KEY=
YOUTUBE_API_KEY=
# Gunakan http://host.docker.internal:11434/api jika backend di Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL_SIZE=medium
TRANSCRIBE_VAD_THRESHOLD=0.5
TRANSCRIBE_VAD_SPEECH_PAD_MS=300
TRANSCRIBE_VAD_MIN_SILENCE_MS=200
TRANSCRIBE_VAD_MIN_SPEECH_MS=80

