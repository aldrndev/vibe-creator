{
  "name": "vibe-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Platform all-in-one untuk daily content creation",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "server": "pnpm --filter @vibe-creator/server dev",
    "web": "pnpm --filter @vibe-creator/web dev",
    "db:migrate": "pnpm --filter @vibe-creator/server db:migrate",
    "db:generate": "pnpm --filter @vibe-creator/server db:generate",
    "db:studio": "pnpm --filter @vibe-creator/server db:studio",
    "clean": "rm -rf node_modules **/*/node_modules **/*/dist **/*/build"
  },
  "keywords": [
    "content-creator",
    "video-editor",
    "prompt-builder"
  ],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
