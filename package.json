{
  "name": "vibe-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Platform all-in-one untuk daily content creation",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api": "pnpm --filter @vibe-creator/api dev",
    "web": "pnpm --filter @vibe-creator/web dev",
    "db:migrate": "pnpm --filter @vibe-creator/api db:migrate",
    "db:generate": "pnpm --filter @vibe-creator/api db:generate",
    "db:studio": "pnpm --filter @vibe-creator/api db:studio",
    "docker:up": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/.env.docker.infra up -d",
    "docker:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f infra/compose/docker-compose.dev.yml logs -f",
    "docker:ps": "docker compose -f infra/compose/docker-compose.dev.yml ps",
    "docker:restart": "pnpm docker:down && pnpm docker:up",
    "docker:build": "docker compose -f infra/compose/docker-compose.dev.yml build",
    "docker:up:build": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/.env.docker.infra up -d --build",
    "docker:prod:up": "docker compose -f infra/compose/docker-compose.prod.single-node.yml up -d",
    "docker:prod:down": "docker compose -f infra/compose/docker-compose.prod.single-node.yml down",
    "docker:prod:logs": "docker compose -f infra/compose/docker-compose.prod.single-node.yml logs -f",
    "docker:prod:ps": "docker compose -f infra/compose/docker-compose.prod.single-node.yml ps",
    "docker:prod:restart": "pnpm docker:prod:down && pnpm docker:prod:up",
    "docker:prod:build": "docker compose -f infra/compose/docker-compose.prod.single-node.yml build",
    "docker:prod:up:build": "docker compose -f infra/compose/docker-compose.prod.single-node.yml up -d --build",
    "layout:check": "node infra/scripts/layout-check.js",
    "clean": "rm -rf node_modules **/*/node_modules **/*/dist **/*/build"
  },
  "keywords": [
    "content-creator",
    "video-editor",
    "prompt-builder"
  ],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.0"
    }
  }
}
