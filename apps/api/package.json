{
  "name": "@vibe-creator/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:deploy && tsx watch src/index.ts",
    "build": "tsc && tsc-alias && rsync -avm --include='*/' --exclude='test_*.py' --include='*.py' --exclude='*' src/ dist/",
    "start": "node dist/index.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "python:venv": "python3 -m venv venv",
    "python:install": "./venv/bin/python -m pip install --upgrade pip && ./venv/bin/python -m pip install -r requirements.txt",
    "python:setup": "pnpm python:venv && pnpm python:install",
    "postinstall": "XDG_CACHE_HOME=../../.cache prisma generate",
    "pretest": "XDG_CACHE_HOME=../../.cache prisma generate",
    "test": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "XDG_CACHE_HOME=../../.cache prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.965.0",
    "@aws-sdk/s3-request-presigner": "3.965.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/csrf-protection": "7.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "9.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "9.0.0",
    "@fastify/swagger": "9.6.1",
    "@fastify/swagger-ui": "5.2.4",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "7.2.0",
    "@vibe-creator/shared": "workspace:*",
    "argon2": "0.44.0",
    "bullmq": "5.66.4",
    "dotenv": "17.2.3",
    "fastify": "5.6.2",
    "fastify-raw-body": "5.0.0",
    "fastify-type-provider-zod": "4.0.2",
    "google-trends-api": "4.9.2",
    "ioredis": "5.9.1",
    "jose": "6.1.3",
    "nanoid": "5.1.6",
    "opossum": "9.0.0",
    "pg": "^8.16.3",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "xendit-node": "7.0.0",
    "youtubei.js": "^16.0.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@prisma/config": "7.2.0",
    "@types/node": "25.0.3",
    "@types/opossum": "8.1.9",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "4.0.16",
    "prisma": "7.2.0",
    "tsc-alias": "1.8.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.0.16"
  }
}
