generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  password             String
  name                 String
  avatarUrl            String?
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  billingSubscription  BillingSubscription?
  directorSessions     DirectorSession[]
  exports              ExportHistory[]
  jobs                 Job[]
  payments             PaymentHistory[]
  projects             Project[]
  prompts              Prompt[]
  streamQuotaCycles    StreamQuotaCycle[]
  streamSessions       StreamSession[]
  streamTopupPurchases StreamTopupPurchase[]
  subscription         Subscription?
  sessions             UserSession[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  token            String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  refreshExpiresAt DateTime
  refreshToken     String    @unique
  consumedAt       DateTime?
  parentTokenId    String?
  tokenFamily      String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([tokenFamily])
  @@index([parentTokenId])
  @@map("user_sessions")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  exportsUsed          Int                @default(0)
  exportsLimit         Int                @default(0)
  validUntil           DateTime?
  xenditSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PaymentHistory {
  id              String           @id @default(cuid())
  userId          String
  amount          Int
  tier            SubscriptionTier
  status          PaymentStatus    @default(PENDING)
  xenditInvoiceId String?          @unique
  xenditPaymentId String?
  paymentMethod   String?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("payment_history")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Project {
  id          String           @id @default(cuid())
  userId      String
  title       String
  description String?
  status      ProjectStatus    @default(DRAFT)
  settings    Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  mode        ProjectMode      @default(TIMELINE)
  storyData   Json?            @map("story_data")
  exports     ExportHistory[]
  jobs        Job[]
  assets      ProjectAsset[]
  versions    ProjectVersion[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeline    Timeline?

  @@index([userId])
  @@map("projects")
}

model ProjectVersion {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?
  timelineData Json
  textOverlays Json     @default("[]")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_versions")
}

model ProjectAsset {
  id        String         @id @default(cuid())
  projectId String
  type      AssetType
  name      String
  sourceUrl String?
  r2Key     String
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips     TimelineClip[]

  @@index([projectId])
  @@map("project_assets")
}

model Timeline {
  id         String          @id @default(cuid())
  projectId  String          @unique
  width      Int             @default(1920)
  height     Int             @default(1080)
  fps        Int             @default(30)
  durationMs Int             @default(0)
  settings   Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tracks     TimelineTrack[]
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("timelines")
}

model TimelineTrack {
  id         String         @id @default(cuid())
  timelineId String
  type       TrackType
  order      Int            @default(0)
  muted      Boolean        @default(false)
  volume     Float          @default(1.0)
  locked     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  clips      TimelineClip[]
  timeline   Timeline       @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@map("timeline_tracks")
}

model TimelineClip {
  id          String        @id @default(cuid())
  trackId     String
  assetId     String?
  startMs     Int           @default(0)
  endMs       Int           @default(0)
  trimStartMs Int           @default(0)
  trimEndMs   Int           @default(0)
  transforms  Json          @default("{}")
  effects     Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  asset       ProjectAsset? @relation(fields: [assetId], references: [id])
  track       TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
  @@map("timeline_clips")
}

model Prompt {
  id               String          @id @default(cuid())
  userId           String
  type             PromptType
  title            String
  currentVersionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  versions         PromptVersion[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("prompts")
}

model PromptVersion {
  id              String   @id @default(cuid())
  promptId        String
  version         Int
  inputData       Json
  generatedPrompt String
  userNotes       String?
  createdAt       DateTime @default(now())
  prompt          Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_versions")
}

model ExportHistory {
  id             String           @id @default(cuid())
  userId         String
  projectId      String?
  format         ExportFormat
  resolution     ExportResolution
  status         ExportStatus     @default(QUEUED)
  r2Key          String?
  fileSizeBytes  BigInt?
  errorMessage   String?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  attempts       Int              @default(0)
  downloadUrl    String?
  idempotencyKey String?          @unique
  localPath      String?
  maxAttempts    Int              @default(3)
  phase          String           @default("QUEUED")
  phaseProgress  Int              @default(0)
  progress       Int              @default(0)
  startedAt      DateTime?
  timelineData   Json?
  urlExpiresAt   DateTime?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("export_history")
}

model DownloadJob {
  id           String         @id @default(cuid())
  userId       String
  sourceUrl    String
  platform     String
  status       DownloadStatus @default(PENDING)
  r2Key        String?
  metadata     Json           @default("{}")
  errorMessage String?
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  localPath    String?
  title        String?

  @@index([userId])
  @@index([status])
  @@map("download_jobs")
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  type        JobType
  status      JobStatus @default(PENDING)
  input       Json      @default("{}")
  output      Json?
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?  @relation(fields: [projectId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@map("jobs")
}

model DirectorSession {
  id              String                   @id @default(cuid())
  userId          String
  step            DirectorStep             @default(IMPORT)
  schemaVersion   Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  analysisJob     DirectorAnalysisJob?
  asset           DirectorAsset?
  clipTranscripts DirectorClipTranscript[]
  exportJob       DirectorExportJob?
  selectedClips   DirectorSelectedClip[]
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtitleStyle   DirectorSubtitleStyle?
  transcribeJob   DirectorTranscribeJob?

  @@index([userId])
  @@map("director_sessions")
}

model DirectorAsset {
  id                  String               @id @default(cuid())
  sessionId           String               @unique
  storageKey          String
  contentHash         String?
  mimeType            String
  sizeBytes           BigInt
  origin              DirectorAssetOrigin
  sourceUrlNormalized String?
  ingestStatus        DirectorIngestStatus @default(UPLOADING)
  durationMs          Int?
  thumbnailStorageKey String?
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now())
  session             DirectorSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("director_assets")
}

model DirectorAnalysisJob {
  id             String                  @id @default(cuid())
  sessionId      String                  @unique
  bullmqJobId    String?
  idempotencyKey String                  @unique
  status         DirectorJobStatus       @default(PENDING)
  config         Json                    @default("{}")
  metrics        Json?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  session        DirectorSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidates     DirectorClipCandidate[]

  @@map("director_analysis_jobs")
}

model DirectorClipCandidate {
  id                     String                 @id @default(cuid())
  analysisJobId          String
  startMs                Int
  endMs                  Int
  tags                   String[]
  score                  Float?
  rank                   Int
  previewStorageKey      String?
  videoPreviewStorageKey String?
  metadata               Json                   @default("{}")
  analysisJob            DirectorAnalysisJob    @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  selectedClips          DirectorSelectedClip[]

  @@index([analysisJobId])
  @@map("director_clip_candidates")
}

model DirectorSelectedClip {
  id          String                  @id @default(cuid())
  sessionId   String
  candidateId String
  trimStartMs Int                     @default(0)
  trimEndMs   Int                     @default(0)
  orderIndex  Int
  createdAt   DateTime                @default(now())
  transcript  DirectorClipTranscript?
  candidate   DirectorClipCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  session     DirectorSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("director_selected_clips")
}

model DirectorTranscribeJob {
  id             String            @id @default(cuid())
  sessionId      String            @unique
  bullmqJobId    String?
  idempotencyKey String            @unique
  status         DirectorJobStatus @default(PENDING)
  engine         String?
  language       String?
  segments       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  session        DirectorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("director_transcribe_jobs")
}

model DirectorSubtitleStyle {
  id             String          @id @default(cuid())
  sessionId      String          @unique
  fontToken      String          @default("font-default")
  textColorToken String          @default("text-white")
  bgColorToken   String          @default("bg-overlay")
  fontSize       Int             @default(32)
  position       String          @default("bottom")
  animation      String          @default("fade")
  createdAt      DateTime        @default(now())
  session        DirectorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("director_subtitle_styles")
}

model DirectorExportJob {
  id               String            @id @default(cuid())
  sessionId        String            @unique
  bullmqJobId      String?
  idempotencyKey   String            @unique
  status           DirectorJobStatus @default(PENDING)
  aspectRatio      String            @default("9:16")
  quality          String            @default("1080p")
  includeSubtitles Boolean           @default(true)
  outputStorageKey String?
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  session          DirectorSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("director_export_jobs")
}

model StreamSession {
  id                    String            @id @default(cuid())
  userId                String
  platform              String
  status                StreamStatus      @default(STARTING)
  startedAt             DateTime          @default(now())
  autoStopAt            DateTime?
  endedAt               DateTime?
  stopReason            StreamStopReason?
  durationMinutesBilled Int?
  quotaCycleId          String?
  config                Json?
  errorMessage          String?
  quotaCycle            StreamQuotaCycle? @relation(fields: [quotaCycleId], references: [id])
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([autoStopAt, status])
  @@map("stream_sessions")
}

model BillingSubscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  provider               String
  providerSubscriptionId String   @unique
  status                 String
  planKey                String
  currentPeriodStartAt   DateTime
  currentPeriodEndAt     DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing_subscriptions")
}

model StreamQuotaCycle {
  id                String                @id @default(cuid())
  userId            String
  cycleStartAt      DateTime
  cycleEndAt        DateTime
  quotaMinutesBase  Int
  quotaMinutesTopup Int                   @default(0)
  quotaMinutesUsed  Int                   @default(0)
  status            String                @default("OPEN")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          StreamSession[]
  topups            StreamTopupPurchase[]

  @@unique([userId, cycleStartAt, cycleEndAt])
  @@index([userId, status])
  @@map("stream_quota_cycles")
}

model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String   @default("XENDIT")
  providerEventId String   @unique
  eventType       String
  payload         Json
  receivedAt      DateTime @default(now())

  @@map("payment_events")
}

model StreamTopupPurchase {
  id                    String            @id @default(cuid())
  userId                String
  provider              String            @default("XENDIT")
  providerPaymentId     String            @unique
  minutes               Int
  amount                Int
  status                String
  appliedToQuotaCycleId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  quotaCycle            StreamQuotaCycle? @relation(fields: [appliedToQuotaCycleId], references: [id])
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stream_topup_purchases")
}

model DirectorClipTranscript {
  id             String               @id @default(cuid())
  sessionId      String               @map("session_id")
  selectedClipId String               @unique @map("selected_clip_id")
  status         DirectorJobStatus    @default(PENDING)
  language       String?
  engine         String               @default("WHISPER_LOCAL")
  segments       Json?
  errorMessage   String?              @map("error_message")
  startedAt      DateTime?            @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  selectedClip   DirectorSelectedClip @relation(fields: [selectedClipId], references: [id], onDelete: Cascade)
  session        DirectorSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("director_clip_transcripts")
}

/// Immutable audit log for security events
model AuditLog {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar
  request_id    String   @db.VarChar
  job_id        String?  @db.VarChar
  user_id       String?  @db.VarChar
  tenant_id     String?  @db.VarChar
  action        String   @db.VarChar
  resource_type String?  @db.VarChar
  resource_id   String?  @db.VarChar
  metadata      Json?    @default("{}")
  ip_address    String?  @db.VarChar
  user_agent    String?
  prev_hash     String?  @db.VarChar(64)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  session_id    String?  @db.VarChar

  @@index([action], map: "idx_audit_logs_action")
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([request_id], map: "idx_audit_logs_request_id")
  @@index([session_id], map: "idx_audit_logs_session_id")
  @@index([user_id], map: "idx_audit_logs_user_id")
  @@map("audit_logs")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  CREATOR
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum ProjectMode {
  STORY
  TIMELINE
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  COMPLETED
}

enum AssetType {
  VIDEO
  AUDIO
  IMAGE
  VOICE
}

enum TrackType {
  VIDEO
  AUDIO
  TEXT
  OVERLAY
}

enum PromptType {
  SCRIPT
  VOICE
  VIDEO_GEN
  IMAGE
  RELAXING
  CREATIVE_SCAN
  TIMELAPSE
}

enum ExportFormat {
  MP4
  WEBM
  MOV
}

enum ExportResolution {
  SD  @map("720P")
  HD  @map("1080P")
  UHD @map("4K")
}

enum ExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  STORY_GENERATION
  SCENE_GENERATION
  ASSET_GENERATION
  DIRECTOR_ANALYSIS
  DIRECTOR_TRANSCRIBE
  DIRECTOR_EXPORT
}

enum DirectorStep {
  IMPORT
  ANALYZING
  PICKING
  EDITING
  EXPORTING
  COMPLETED
}

enum DirectorAssetOrigin {
  UPLOAD
  URL_IMPORT
}

enum DirectorIngestStatus {
  UPLOADING
  READY
  FAILED
}

enum DirectorJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StreamStatus {
  CREATED
  STARTING
  LIVE
  STOPPING
  STOPPED
  FAILED
  ENDED
}

enum StreamStopReason {
  USER_REQUEST
  AUTO_STOP
  ERROR
  ADMIN
  SERVER_RESTART
  QUOTA_EXHAUSTED
}
