# Server Environment Variables
# Copy to apps/server/.env and fill in secrets

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vibe_creator?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (required, no defaults)
JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars

# JWT Key Ring (ES256)
JWT_SIGNING_KEY_ID=key-2026-01
JWT_SIGNING_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
JWT_VERIFY_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"..."}]

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Auth Migration Flags
ENABLE_LEGACY_SESSION_AUTH=false

# Rate Limit (tests only)
RATE_LIMIT_TEST_MODE=false

# Swagger (disabled in production by default)
ENABLE_SWAGGER=false
SWAGGER_ALLOWED_IPS=127.0.0.1

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vibe-creator
R2_PUBLIC_URL=

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Video Processing
MAX_VIDEO_DURATION_MS=3600000
MAX_UPLOAD_SIZE_MB=2048
TEMP_DIR=./uploads/temp
OUTPUT_DIR=./uploads/exports
MEDIA_INPUT_DIR=./uploads

# Video Download (Cobalt)
COBALT_API_URL=http://localhost:9000

# AI Services
SAVESORA_API_KEY=
AI_COPY_PROVIDER=ollama
OPENAI_API_KEY=
# Gunakan http://host.docker.internal:11434/api jika backend di Docker
# Gunakan http://localhost:11434/api jika backend langsung di host
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL_SIZE=medium
TRANSCRIBE_PROVIDER=auto
TRANSCRIBE_SERVICE_URL=http://localhost:8765
TRANSCRIBE_SERVICE_TOKEN=
TRANSCRIBE_HTTP_TIMEOUT_MS=120000
TRANSCRIBE_ALLOW_LOCAL_FALLBACK=true
TRANSCRIBE_LANGUAGE=mixed
TRANSCRIBE_VAD_THRESHOLD=0.5
TRANSCRIBE_VAD_SPEECH_PAD_MS=300
TRANSCRIBE_VAD_MIN_SILENCE_MS=200
TRANSCRIBE_VAD_MIN_SPEECH_MS=80
